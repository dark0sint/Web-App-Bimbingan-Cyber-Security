<%- include('../partials/header') %>

<a href="/admin" class="back-link">&larr; Kembali ke Panel Admin</a>
<h1 class="page-title">👥 Kelola Pengguna</h1>

<table class="admin-table">
  <thead><tr><th>Nama</th><th>Email</th><th>Role</th><th>Bergabung</th><th>Ubah Role</th></tr></thead>
  <tbody>
    <% users.forEach(u => { %>
      <tr>
        <td><%= u.name %></td>
        <td><%= u.email %></td>
        <td><span class="role-badge role-<%= u.role %>"><%= u.role %></span></td>
        <td><%= u.created_at %></td>
        <td>
          <form method="POST" action="/admin/users/<%= u.id %>/role" class="inline-form">
            <select name="role" onchange="this.form.submit()">
              <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>student</option>
              <option value="mentor" <%= u.role === 'mentor' ? 'selected' : '' %>>mentor</option>
              <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
            </select>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
