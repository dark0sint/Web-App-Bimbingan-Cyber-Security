<%- include('../partials/header') %>

<a href="/admin" class="back-link">&larr; Kembali ke Panel Admin</a>
<h1 class="page-title">📚 Kelola Modul</h1>

<div class="card form-card">
  <h3>Tambah Modul</h3>
  <form method="POST" action="/admin/modules/new">
    <label>Learning Path</label>
    <select name="path_id" required>
      <% paths.forEach(p => { %><option value="<%= p.id %>"><%= p.title %></option><% }) %>
    </select>
    <label>Judul Modul</label>
    <input type="text" name="title" required>
    <label>Konten Materi</label>
    <textarea name="content" rows="4" required></textarea>
    <label>Skill Tag</label>
    <select name="skill_tag_id">
      <option value="">- Tanpa Skill Tag -</option>
      <% skills.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
    </select>
    <label>Urutan</label>
    <input type="number" name="order_index" value="0">
    <label>Pertanyaan Kuis</label>
    <input type="text" name="quiz_question" placeholder="Opsional">
    <label>Opsi Jawaban (satu per baris)</label>
    <textarea name="quiz_options" rows="4" placeholder="Opsi A&#10;Opsi B&#10;Opsi C&#10;Opsi D"></textarea>
    <label>Index Jawaban Benar (mulai dari 0)</label>
    <input type="number" name="quiz_answer_index" value="0" min="0">
    <button type="submit" class="btn btn-primary">Tambah Modul</button>
  </form>
</div>

<table class="admin-table">
  <thead><tr><th>Path</th><th>Judul</th><th>Urutan</th><th>Aksi</th></tr></thead>
  <tbody>
    <% modules.forEach(m => { %>
      <tr>
        <td><%= m.path_title %></td>
        <td><%= m.title %></td>
        <td><%= m.order_index %></td>
        <td>
          <form method="POST" action="/admin/modules/<%= m.id %>/delete" class="inline-form" onsubmit="return confirm('Hapus modul ini?')">
            <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
